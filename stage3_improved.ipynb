featured_data.head()class DataLoader:
    """Enhanced data loading class with robust error handling and validation."""
    
    @staticmethod
    def load_data(file_path: str) -> pd.DataFrame:
        """
        Load data from a CSV file with comprehensive validation.
        
        Args:
            file_path (str): Path to the CSV file
            
        Returns:
            pd.DataFrame: Loaded dataset
            
        Raises:
            FileNotFoundError: If file doesn't exist
            ValueError: If file format is not supported
        """
        path = Path(file_path)
        
        # Validate file existence
        if not path.exists():
            raise FileNotFoundError(f"File not found: {file_path}")
        
        # Validate file format
        if path.suffix.lower() != '.csv':
            raise ValueError(f"Unsupported file format: {path.suffix}. Only CSV files are supported.")
        
        try:
            data = pd.read_csv(file_path)
            print(f"✅ Successfully loaded data from {file_path}")
            print(f"📊 Dataset shape: {data.shape}")
            return data
        except Exception as e:
            raise RuntimeError(f"Failed to load data: {str(e)}")

# Load the dataset
data_loader = DataLoader()
featured_data = data_loader.load_data("data/ml_stem_analysis.csv")# Import libraries
